# Environment
.env

# Virtual environment
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Database
*.db
*.db-wal
*.db-shm
second_rail.db

# LLM response cache — committed from Phase 18 onward so `make eval` runs
# offline with no key. Until then, generated cache entries stay untracked.
cache/*.json
!cache/.gitkeep

# Per-run audit chains are working output, not evidence — a small,
# committed excerpt (evidence/audit_sample.jsonl) is added in Phase 18.
evidence/audit/*.jsonl
!evidence/audit/.gitkeep
