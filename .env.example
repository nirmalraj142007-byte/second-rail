# Razorpay API key id (test mode). Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=

# Razorpay API key secret. Never commit a real value here.
RAZORPAY_KEY_SECRET=

# HMAC secret configured on the payment.failed webhook; verifies signatures at ingest.
RAZORPAY_WEBHOOK_SECRET=

# LLM provider backing diagnose/choose: gemini, openai, or none.
LLM_PROVIDER=none

# API key for the configured LLM provider.
LLM_API_KEY=

# Model name passed to the LLM provider.
LLM_MODEL=gemini-2.5-flash

# Path to the SQLite database file.
DB_PATH=second_rail.db

# Directory where the hash-chained audit JSONL is written.
AUDIT_DIR=evidence/audit

# Directory for the content-addressed LLM response cache.
CACHE_DIR=cache

# Run mode: dry_run (default, no external calls), execute (real Razorpay calls), fixture (replay).
MODE=dry_run

# IANA timezone used for all timestamps in logs and the audit trail.
TIMEZONE=Asia/Kolkata
