# Razorpay API key id (test mode). Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=

# Razorpay API key secret. Never commit a real value here.
RAZORPAY_KEY_SECRET=

# HMAC secret configured on the payment.failed webhook; verifies signatures at ingest.
RAZORPAY_WEBHOOK_SECRET=

# LLM provider backing diagnose/choose: gemini, openai, groq, or none.
LLM_PROVIDER=none

# API key for the configured LLM provider.
LLM_API_KEY=

# Model name passed to the LLM provider. Matches the model that actually
# populated the committed cache/*.json — see BUILD_LOG.md for why that's
# Groq's openai/gpt-oss-20b rather than gemini-2.5-flash (named in CLAUDE.md
# and the original proposal; HTTP 404 "no longer available to new users" on
# a live call 2026-08-30) or gemini-3.6-flash (free tier couldn't sustain
# this phase's evidence pass at any RPM pacing that actually held).
LLM_MODEL=openai/gpt-oss-20b

# Path to the SQLite database file.
DB_PATH=second_rail.db

# Directory where the hash-chained audit JSONL is written.
AUDIT_DIR=evidence/audit

# Directory for the content-addressed LLM response cache.
CACHE_DIR=cache

# Run mode: dry_run (default, no external calls), execute (real Razorpay calls), fixture (replay).
MODE=dry_run

# IANA timezone used for all timestamps in logs and the audit trail.
TIMEZONE=Asia/Kolkata
